
<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.6//EN'
'http://www.it.uu.se/research/group/darts/uppaal/flat-1_6.dtd'>

<nta>

<!-- ===================================================== -->
<!-- GLOBAL DECLARATIONS                                   -->
<!-- ===================================================== -->

<declaration>

const int DEPLETED = 0;
const int LOW      = 1;
const int NORMAL   = 2;
const int HIGH     = 3;
const int OVERFLOW = 4;

/* Physical state */
int tank_level = NORMAL;
int sensor_level = NORMAL;
int secure_sensor_level = NORMAL;

/* Data validity */
bool data_valid = true;

/* Control */
bool pump_state = false;
bool pump_cmd_on = false;
bool pump_cmd_off = false;

/* Security */
bool intrusion_detected = false;
bool safe_mode = false;
bool alarm_integrity = false;
bool alarm_dos = false;

/* Attack flags */
bool fdi_active = false;
bool dos_active = false;

/* Recovery monitoring */
int clean_count = 0;
const int RECOVERY_THRESHOLD = 3;

/* Thresholds */
const int LOWER_THRESHOLD = LOW;
const int UPPER_THRESHOLD = HIGH;

/* Communication channels */
chan sensor_sample;
chan net_deliver_sensor;
chan safe_mode_on;
chan safe_mode_off;
chan dos_block;

/* Timing */
const int Ts_min = 1;
const int Ts_max = 5;

</declaration>


<!-- ===================================================== -->
<!-- TANK                                                   -->
<!-- ===================================================== -->

<template>

<name>Tank</name>

<location id="t0">
<name>Normal</name>
</location>

<location id="t1">
<name>Low</name>
</location>

<location id="t2">
<name>High</name>
</location>

<location id="t3">
<name>Overflow</name>
</location>

<init ref="t0"/>

<!-- Normal to Low -->

<transition>
<source ref="t0"/>
<target ref="t1"/>
<label kind="guard">!pump_state</label>
<label kind="assignment">tank_level = LOW</label>
</transition>

<!-- Low to Normal -->

<transition>
<source ref="t1"/>
<target ref="t0"/>
<label kind="guard">pump_state</label>
<label kind="assignment">tank_level = NORMAL</label>
</transition>

<!-- Normal to High -->

<transition>
<source ref="t0"/>
<target ref="t2"/>
<label kind="guard">pump_state</label>
<label kind="assignment">tank_level = HIGH</label>
</transition>

<!-- High to Overflow -->
<!-- Safe mode prevents further filling -->

<transition>
<source ref="t2"/>
<target ref="t3"/>
<label kind="guard">pump_state &amp;&amp; !safe_mode</label>
<label kind="assignment">tank_level = OVERFLOW</label>
</transition>

</template>


<!-- ===================================================== -->
<!-- SENSOR                                                 -->
<!-- ===================================================== -->

<template>

<name>Sensor</name>

<declaration>
clock x;
</declaration>

<location id="s0">
<label kind="invariant">x &lt;= Ts_max</label>
</location>

<init ref="s0"/>

<transition>
<source ref="s0"/>
<target ref="s0"/>

<label kind="guard">x &gt;= Ts_min</label>

<label kind="synchronisation">
sensor_sample!
</label>

<label kind="assignment">
sensor_level = tank_level,
x = 0
</label>

</transition>

</template>


<!-- ===================================================== -->
<!-- NETWORK                                                -->
<!-- ===================================================== -->

<template>

<name>Network</name>

<location id="n0">
<name>Operational</name>
</location>

<location id="n1">
<name>Blocked</name>
</location>

<init ref="n0"/>

<!-- Normal sensor communication -->

<transition>
<source ref="n0"/>
<target ref="n0"/>

<label kind="guard">
!dos_active &amp;&amp; !fdi_active
</label>

<label kind="synchronisation">
sensor_sample?
</label>

<label kind="synchronisation">
net_deliver_sensor!
</label>

<label kind="assignment">
secure_sensor_level = sensor_level
</label>

</transition>

<!-- False data injection -->

<transition>
<source ref="n0"/>
<target ref="n0"/>

<label kind="guard">
fdi_active &amp;&amp; !dos_active
</label>

<label kind="synchronisation">
sensor_sample?
</label>

<label kind="synchronisation">
net_deliver_sensor!
</label>

<label kind="assignment">
secure_sensor_level = LOW
</label>

</transition>

<!-- Denial of service -->

<transition>
<source ref="n0"/>
<target ref="n1"/>

<label kind="synchronisation">
dos_block?
</label>

<label kind="assignment">
dos_active = true
</label>

</transition>

</template>


<!-- ===================================================== -->
<!-- INTRUSION DETECTION SYSTEM                             -->
<!-- ===================================================== -->

<template>

<name>IDS</name>

<location id="i0"/>

<init ref="i0"/>

<transition>
<source ref="i0"/>
<target ref="i0"/>

<label kind="synchronisation">
net_deliver_sensor?
</label>

<label kind="assignment">
intrusion_detected =
    (secure_sensor_level != sensor_level),

alarm_integrity =
    (secure_sensor_level != sensor_level),

data_valid =
    (secure_sensor_level == sensor_level),

clean_count =
    (secure_sensor_level == sensor_level
     ? clean_count + 1 : 0)
</label>

</transition>

</template>


<!-- ===================================================== -->
<!-- SAFE MODE CONTROLLER                                   -->
<!-- ===================================================== -->

<template>

<name>SafeMode</name>

<location id="sm0">
<name>NormalMode</name>
</location>

<location id="sm1">
<name>SafeMode</name>
</location>

<init ref="sm0"/>

<!-- Enter safe mode following an integrity or DoS alarm -->

<transition>
<source ref="sm0"/>
<target ref="sm1"/>

<label kind="guard">
alarm_integrity || dos_active
</label>

<label kind="assignment">
safe_mode = true,
pump_state = false,
pump_cmd_on = false,
pump_cmd_off = false
</label>

</transition>

<!-- Exit safe mode after sufficient clean measurements
     and restoration of the communication channel -->

<transition>
<source ref="sm1"/>
<target ref="sm0"/>

<label kind="guard">
clean_count &gt;= RECOVERY_THRESHOLD
&amp;&amp; !dos_active
</label>

<label kind="assignment">
safe_mode = false,
alarm_integrity = false,
intrusion_detected = false,
data_valid = true,
clean_count = 0
</label>

</transition>

</template>


<!-- ===================================================== -->
<!-- PLC                                                    -->
<!-- ===================================================== -->

<template>

<name>PLC</name>

<location id="p0"/>

<init ref="p0"/>

<!-- Pump ON command -->

<transition>
<source ref="p0"/>
<target ref="p0"/>

<label kind="guard">
!safe_mode
&amp;&amp; data_valid
&amp;&amp; secure_sensor_level &lt;= LOWER_THRESHOLD
</label>

<label kind="assignment">
pump_cmd_on = true,
pump_cmd_off = false
</label>

</transition>

<!-- Pump OFF command -->

<transition>
<source ref="p0"/>
<target ref="p0"/>

<label kind="guard">
secure_sensor_level &gt;= UPPER_THRESHOLD
|| safe_mode
</label>

<label kind="assignment">
pump_cmd_on = false,
pump_cmd_off = true
</label>

</transition>

</template>


<!-- ===================================================== -->
<!-- PUMP ACTUATOR                                          -->
<!-- ===================================================== -->

<template>

<name>Pump</name>

<location id="a0"/>

<init ref="a0"/>

<!-- Safe mode override -->

<transition>
<source ref="a0"/>
<target ref="a0"/>

<label kind="guard">
safe_mode
</label>

<label kind="assignment">
pump_state = false,
pump_cmd_on = false,
pump_cmd_off = false
</label>

</transition>

<!-- Execute pump ON command -->

<transition>
<source ref="a0"/>
<target ref="a0"/>

<label kind="guard">
pump_cmd_on &amp;&amp; !safe_mode
</label>

<label kind="assignment">
pump_state = true,
pump_cmd_on = false
</label>

</transition>

<!-- Execute pump OFF command -->

<transition>
<source ref="a0"/>
<target ref="a0"/>

<label kind="guard">
pump_cmd_off || safe_mode
</label>

<label kind="assignment">
pump_state = false,
pump_cmd_off = false
</label>

</transition>

</template>


<!-- ===================================================== -->
<!-- FALSE DATA INJECTION ATTACKER                          -->
<!-- ===================================================== -->

<template>

<name>FDI_Attacker</name>

<location id="f0">
<name>Idle</name>
</location>

<init ref="f0"/>

<transition>
<source ref="f0"/>
<target ref="f0"/>

<label kind="assignment">
fdi_active = true
</label>

</transition>

</template>


<!-- ===================================================== -->
<!-- SYSTEM INSTANTIATION                                   -->
<!-- ===================================================== -->

<system>

tank = Tank();
sensor = Sensor();
network = Network();
ids = IDS();
safe = SafeMode();
plc = PLC();
pump = Pump();
att = FDI_Attacker();

system tank,
       sensor,
       network,
       ids,
       safe,
       plc,
       pump,
       att;

</system>


<!-- ===================================================== -->
<!-- VERIFICATION QUERIES                                   -->
<!-- Original three formulas preserved                     -->
<!-- ===================================================== -->

<queries>

<query>
<formula>A[] safe_mode imply tank_level != OVERFLOW</formula>
<comment>
Safety guaranteed in safe mode.
</comment>
</query>

<query>
<formula>E&lt;&gt; safe_mode</formula>
<comment>
Safe mode is reachable.
</comment>
</query>

<query>
<formula>E&lt;&gt; alarm_integrity</formula>
<comment>
Intrusion detection triggers.
</comment>
</query>

</queries>

</nta>
