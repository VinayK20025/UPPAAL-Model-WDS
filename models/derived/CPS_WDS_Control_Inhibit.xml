<?xml version='1.0' encoding='utf-8'?>
<nta>
    <declaration>
const int DEPLETED = 0;
const int LOW      = 1;
const int NORMAL   = 2;
const int HIGH     = 3;
const int OVERFLOW = 4;

/* Physical state */
int tank_level   = NORMAL;
int sensor_level = NORMAL;
int secure_sensor_level = NORMAL;

/* Actuation */
bool pump_state   = false;
bool pump_cmd_on  = false;
bool pump_cmd_off = false;

/* Security abstraction */
bool intrusion_detected = false;
bool data_valid         = false;

/* Thresholds */
const int LOWER_THRESHOLD = LOW;
const int UPPER_THRESHOLD = HIGH;

/* Channels */
chan sensor_sample;
chan net_deliver_sensor;
chan plc_to_actuator;
chan net_deliver_cmd;

/* Timing */
const int Ts_min = 1, Ts_max = 5;

// Explicit measurement freshness
bool sensor_fresh = false;
bool measurement_fresh = false;

// False-data injection attacker state
bool fdi_active = false;

// Records whether an FDI episode has occurred
bool attack_occurred = false;

// Consecutive clean-measurement recovery qualification.
const int RECOVERY_THRESHOLD = 3;
int clean_count = 0;
bool recovery_completed = false;
bool recovery_sample_clean = false;
chan ids_sample;

// Latched defensive control inhibition
bool control_inhibit = false;
</declaration>
    <template>
        <name>Tank</name>
        <location id="id0" x="40" y="80">
            <name x="30" y="50">Normal</name>
        </location>
        <location id="id1" x="190" y="80">
            <name x="180" y="50">Low</name>
        </location>
        <location id="id2" x="190" y="230">
            <name x="180" y="200">High</name>
        </location>
        <location id="id3" x="40" y="230">
            <name x="30" y="200">Overflow</name>
        </location>
        <location id="id4" x="340" y="80">
            <name x="330" y="50">Depleted</name>
        </location>
        <init ref="id0" />
        <transition id="id5">
            <source ref="id0" />
            <target ref="id1" />
            <label kind="guard" x="55" y="50">!pump_state</label>
            <label kind="assignment" x="55" y="80">tank_level = LOW,
sensor_fresh = false,
measurement_fresh = false,
data_valid = false</label>
        </transition>
        <transition id="id6">
            <source ref="id1" />
            <target ref="id0" />
            <label kind="guard" x="55" y="50">pump_state</label>
            <label kind="assignment" x="55" y="80">tank_level = NORMAL,
sensor_fresh = false,
measurement_fresh = false,
data_valid = false</label>
        </transition>
        <transition id="id7">
            <source ref="id0" />
            <target ref="id2" />
            <label kind="guard" x="55" y="125">pump_state</label>
            <label kind="assignment" x="55" y="155">tank_level = HIGH,
sensor_fresh = false,
measurement_fresh = false,
data_valid = false,
      pump_state = false,
      pump_cmd_on = false,
      pump_cmd_off = false</label>
        </transition>
        <transition id="id8">
            <source ref="id2" />
            <target ref="id3" />
            <label kind="guard" x="55" y="200">pump_state</label>
            <label kind="assignment" x="55" y="230">tank_level = OVERFLOW,
sensor_fresh = false,
measurement_fresh = false,
data_valid = false</label>
        </transition>
    </template>
    <template>
        <name>Sensor</name>
        <declaration>clock x_s;</declaration>
        <location id="id9" x="40" y="80">
            <label kind="invariant" x="30" y="95">x_s &lt;= Ts_max</label>
        </location>
        <init ref="id9" />
        <transition id="id10">
            <source ref="id9" />
            <target ref="id9" />
            <label kind="guard" x="-20" y="50">x_s &gt;= Ts_min</label>
            <label kind="assignment" x="-20" y="80">sensor_level = tank_level,
      sensor_fresh = true,
      x_s = 0</label>
            <nail x="10" y="50" />
            <nail x="70" y="50" />
        </transition>
    </template>
    <template>
        <name>Network</name>
        <location id="id11" x="40" y="80">
		</location>
        <init ref="id11" />
        <transition id="id12">
            <source ref="id11" />
            <target ref="id11" />
            <label kind="select" x="-20" y="35">v : int[DEPLETED, OVERFLOW]</label>
            <label kind="synchronisation" x="-20" y="65">net_deliver_sensor!</label>
            <label kind="assignment" x="-20" y="80">secure_sensor_level = sensor_level,
      measurement_fresh = sensor_fresh</label>
            <nail x="10" y="50" />
            <nail x="70" y="50" />
        </transition>
    </template>
    <template>
        <name>IDS</name>
        <location id="id13" x="40" y="80"/>
        <location id="recovery_notify_location" x="260" y="80"/>
        <init ref="id13"/>
        <transition id="id14">
            <source ref="id13"/>
            <target ref="recovery_notify_location"/>
            <label kind="synchronisation" x="-20" y="65">net_deliver_sensor?</label>
            <label kind="assignment" x="-20" y="80">intrusion_detected =
    measurement_fresh &amp;&amp; (secure_sensor_level != tank_level),
data_valid =
    measurement_fresh &amp;&amp; (secure_sensor_level == tank_level) &amp;&amp; !fdi_active,
recovery_sample_clean =
    measurement_fresh &amp;&amp; (secure_sensor_level == tank_level) &amp;&amp; !fdi_active,
control_inhibit =
    (measurement_fresh &amp;&amp; (secure_sensor_level != tank_level)) ||
    (control_inhibit &amp;&amp;
     !(measurement_fresh &amp;&amp; (secure_sensor_level == tank_level) &amp;&amp; !fdi_active)),
pump_state =
    (measurement_fresh &amp;&amp; (secure_sensor_level != tank_level))
    ? false : pump_state,
pump_cmd_on =
    (measurement_fresh &amp;&amp; (secure_sensor_level != tank_level))
    ? false : pump_cmd_on,
pump_cmd_off =
    (measurement_fresh &amp;&amp; (secure_sensor_level != tank_level))
    ? false : pump_cmd_off</label>
        </transition>
        <transition id="ids_recovery_notify">
            <source ref="recovery_notify_location"/>
            <target ref="id13"/>
            <label kind="synchronisation" x="170" y="120">ids_sample!</label>
        </transition>
    </template>
    <template>
        <name>RecoveryMonitor</name>
        <location id="recovery_wait0" x="80" y="160"><name x="80" y="135">Wait0</name></location>
        <location id="recovery_wait1" x="240" y="160"><name x="240" y="135">Wait1</name></location>
        <location id="recovery_wait2" x="400" y="160"><name x="400" y="135">Wait2</name></location>
        <location id="recovery_recovered" x="560" y="160"><name x="560" y="135">Recovered</name></location>
        <init ref="recovery_wait0"/>
        <transition id="recovery_count_1">
            <source ref="recovery_wait0"/><target ref="recovery_wait1"/>
            <label kind="guard" x="120" y="210">recovery_sample_clean &amp;&amp; control_inhibit</label>
            <label kind="synchronisation" x="120" y="230">ids_sample?</label>
            <label kind="assignment" x="120" y="250">clean_count = 1, recovery_completed = false</label>
        </transition>
        <transition id="recovery_count_2">
            <source ref="recovery_wait1"/><target ref="recovery_wait2"/>
            <label kind="guard" x="280" y="210">recovery_sample_clean &amp;&amp; control_inhibit</label>
            <label kind="synchronisation" x="280" y="230">ids_sample?</label>
            <label kind="assignment" x="280" y="250">clean_count = 2, recovery_completed = false</label>
        </transition>
        <transition id="recovery_complete">
            <source ref="recovery_wait2"/><target ref="recovery_recovered"/>
            <label kind="guard" x="440" y="210">recovery_sample_clean &amp;&amp; control_inhibit</label>
            <label kind="synchronisation" x="440" y="230">ids_sample?</label>
            <label kind="assignment" x="440" y="250">clean_count = RECOVERY_THRESHOLD, recovery_completed = true, control_inhibit = false</label>
        </transition>
        <transition id="recovery_reset_0">
            <source ref="recovery_wait0"/><target ref="recovery_wait0"/>
            <label kind="guard" x="100" y="330">!recovery_sample_clean</label>
            <label kind="synchronisation" x="100" y="350">ids_sample?</label>
            <label kind="assignment" x="100" y="370">clean_count = 0, recovery_completed = false</label>
        </transition>
        <transition id="recovery_reset_1">
            <source ref="recovery_wait1"/><target ref="recovery_wait0"/>
            <label kind="guard" x="100" y="330">!recovery_sample_clean</label>
            <label kind="synchronisation" x="100" y="350">ids_sample?</label>
            <label kind="assignment" x="100" y="370">clean_count = 0, recovery_completed = false</label>
        </transition>
        <transition id="recovery_reset_2">
            <source ref="recovery_wait2"/><target ref="recovery_wait0"/>
            <label kind="guard" x="100" y="330">!recovery_sample_clean</label>
            <label kind="synchronisation" x="100" y="350">ids_sample?</label>
            <label kind="assignment" x="100" y="370">clean_count = 0, recovery_completed = false</label>
        </transition>
        <transition id="recovery_reset_after">
            <source ref="recovery_recovered"/><target ref="recovery_wait0"/>
            <label kind="guard" x="100" y="330">!recovery_sample_clean</label>
            <label kind="synchronisation" x="100" y="350">ids_sample?</label>
            <label kind="assignment" x="100" y="370">clean_count = 0, recovery_completed = false</label>
        </transition>
        <transition id="recovery_hold">
            <source ref="recovery_recovered"/><target ref="recovery_recovered"/>
            <label kind="synchronisation" x="560" y="270">ids_sample?</label>
        </transition>
        <transition id="recovery_wait_clean_without_inhibit">
            <source ref="recovery_wait0"/><target ref="recovery_wait0"/>
            <label kind="guard" x="80" y="250">recovery_sample_clean &amp;&amp; !control_inhibit</label>
            <label kind="synchronisation" x="80" y="270">ids_sample?</label>
            <label kind="assignment" x="80" y="290">clean_count = 0</label>
        </transition>
    </template>
    <template>
        <name>PLC</name>
        <location id="id15" x="40" y="80">
		</location>
        <init ref="id15" />
        <transition id="id16">
            <source ref="id15" />
            <target ref="id15" />
            <label kind="guard" x="-20" y="50">data_valid &amp;&amp; measurement_fresh &amp;&amp; !intrusion_detected &amp;&amp; secure_sensor_level &lt;= LOWER_THRESHOLD &amp;&amp; !control_inhibit &amp;&amp; !pump_state</label>
            <label kind="assignment" x="-20" y="80">pump_cmd_on = true,
      pump_cmd_off = false</label>
            <nail x="10" y="50" />
            <nail x="70" y="50" />
        </transition>
        <transition id="id17">
            <source ref="id15" />
            <target ref="id15" />
            <label kind="guard" x="-20" y="50">secure_sensor_level &gt;= UPPER_THRESHOLD</label>
            <label kind="assignment" x="-20" y="80">pump_cmd_on = false,
      pump_cmd_off = true</label>
            <nail x="10" y="50" />
            <nail x="70" y="50" />
        </transition>
    </template>
    <template>
        <name>Pump</name>
        <location id="id18" x="40" y="80">
		</location>
        <init ref="id18" />
        <transition id="id19">
            <source ref="id18" />
            <target ref="id18" />
            <label kind="guard" x="-20" y="50">pump_cmd_on &amp;&amp; tank_level &lt; HIGH &amp;&amp; data_valid &amp;&amp; measurement_fresh &amp;&amp; !intrusion_detected &amp;&amp; !control_inhibit</label>
            <label kind="assignment" x="-20" y="80">pump_state = true,
      pump_cmd_on = false</label>
            <nail x="10" y="50" />
            <nail x="70" y="50" />
        </transition>
        <transition id="id20">
            <source ref="id18" />
            <target ref="id18" />
            <label kind="guard" x="-20" y="50">pump_cmd_off</label>
            <label kind="assignment" x="-20" y="80">pump_state = false,
      pump_cmd_off = false</label>
            <nail x="10" y="50" />
            <nail x="70" y="50" />
        </transition>
        <transition>
            <source ref="id18" />
            <target ref="id18" />
            <label kind="guard" x="0" y="0">control_inhibit &amp;&amp; (pump_state || pump_cmd_on)</label>
            <label kind="assignment" x="0" y="0">pump_state = false, pump_cmd_on = false, pump_cmd_off = false</label>
        </transition>
    </template>
    <template>
        <name>FDI_Attacker</name>
        <location id="fdi_loc_idle" x="100" y="100">
            <name x="70" y="70">Idle</name>
        </location>
        <location id="fdi_loc_injecting" x="340" y="100">
            <name x="310" y="70">Injecting</name>
        </location>
        <init ref="fdi_loc_idle" />
        <transition>
            <source ref="fdi_loc_idle" />
            <target ref="fdi_loc_injecting" />
            <label kind="guard" x="120" y="80">sensor_fresh &amp;&amp; !fdi_active &amp;&amp; tank_level == NORMAL &amp;&amp; sensor_level == NORMAL</label>
            <label kind="assignment" x="120" y="110">sensor_level = HIGH, fdi_active = true, attack_occurred = true, data_valid = false</label>
        </transition>
        <transition id="fdi_transition_termination">
            <source ref="fdi_loc_injecting" />
            <target ref="fdi_loc_idle" />
            <label kind="guard" x="370" y="130">intrusion_detected &amp;&amp; fdi_active</label>
            <label kind="assignment" x="370" y="160">fdi_active = false, sensor_fresh = false, measurement_fresh = false, data_valid = false</label>
        </transition>
    </template>
    <system>fdi_attacker = FDI_Attacker();

tank = Tank();
sensor = Sensor();
network = Network();
ids = IDS();
plc = PLC();
pump = Pump();
recovery_monitor = RecoveryMonitor();

system tank, sensor, network, ids, plc, pump, fdi_attacker, recovery_monitor;
</system>
    <queries>
        <query>
            <formula>A[] not tank.Overflow</formula>
            <comment>Safety: Tank never overflows</comment>
            <result outcome="failure" type="quality" timestamp="2026-03-31 23:54:52 +0530">
			</result>
        </query>
        <query>
            <formula>A[] not tank.Depleted</formula>
            <comment>Safety: Tank never depletes</comment>
            <result outcome="success" type="quality" timestamp="2026-03-31 23:54:54 +0530">
			</result>
        </query>
        <query>
            <formula>E&lt;&gt; tank.Normal</formula>
            <comment>Liveness: System can reach Normal state</comment>
            <result outcome="success" type="quality" timestamp="2026-03-31 23:54:55 +0530">
			</result>
        </query>
        <query>
            <formula>A[] sensor_level == tank_level</formula>
            <comment>Raw sensor integrity</comment>
            <result outcome="failure" type="quality" timestamp="2026-03-31 23:54:56 +0530">
			</result>
        </query>
        <query>
            <formula>A[] (not intrusion_detected imply secure_sensor_level == tank_level)</formula>
            <comment>Secure data integrity under no alarm</comment>
            <result outcome="failure" type="quality" timestamp="2026-03-31 23:54:58 +0530">
			</result>
        </query>
        <query>
            <formula>A[] !(pump_cmd_on &amp;&amp; pump_cmd_off)</formula>
            <comment>No conflicting actuator commands</comment>
            <result outcome="success" type="quality" timestamp="2026-03-31 23:54:59 +0530">
			</result>
        </query>
        <query>
            <formula>E&lt;&gt; intrusion_detected</formula>
            <comment>Intrusion detection is reachable</comment>
            <result outcome="success" type="quality" timestamp="2026-03-31 23:55:01 +0530">
			</result>
        </query>
    </queries>
</nta>