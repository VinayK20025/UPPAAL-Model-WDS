
<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.6//EN'
'http://www.it.uu.se/research/group/darts/uppaal/flat-1_6.dtd'>

<nta>

<!-- ===================================================== -->
<!-- GLOBAL DECLARATIONS                                   -->
<!-- ===================================================== -->

<declaration>

const int DEPLETED = 0;
const int LOW      = 1;
const int NORMAL   = 2;
const int HIGH     = 3;
const int OVERFLOW = 4;

/* Physical system and digital twin */

int tank_level = NORMAL;
int sensor_level = NORMAL;
int secure_sensor_level = NORMAL;
int twin_estimate = NORMAL;

/* Control */

bool pump_state = false;
bool pump_cmd_on = false;
bool pump_cmd_off = false;

/* Security and AI monitoring */

bool intrusion_detected = false;
bool ai_alarm = false;
bool operator_ack = false;
bool safe_mode = false;
bool data_valid = true;

/* Attack flags */

bool fdi_active = false;
bool replay_active = false;
bool dos_active = false;

/* Replay buffer */

int replay_buffer = NORMAL;

/* Timed detection and response */

clock t_detect;
clock t_response;

const int Td_max = 5;
const int Tr_max = 3;

/* Thresholds */

const int LOWER_THRESHOLD = LOW;
const int UPPER_THRESHOLD = HIGH;

/* Communication channels */

chan sensor_sample;
chan net_deliver_sensor;

chan fdi_trigger;
chan replay_trigger;
chan dos_block;
chan dos_release;

/* Sampling period */

const int Ts_min = 1;
const int Ts_max = 5;

/* Recovery monitoring */

int clean_count = 0;
const int RECOVERY_THRESHOLD = 3;

</declaration>


<!-- ===================================================== -->
<!-- TANK                                                   -->
<!-- ===================================================== -->

<template>

<name>Tank</name>

<location id="t0">
<name>Normal</name>
</location>

<location id="t1">
<name>Low</name>
</location>

<location id="t2">
<name>High</name>
</location>

<location id="t3">
<name>Overflow</name>
</location>

<init ref="t0"/>

<!-- Normal to Low -->

<transition>
<source ref="t0"/>
<target ref="t1"/>

<label kind="guard">
!pump_state
</label>

<label kind="assignment">
tank_level = LOW
</label>

</transition>

<!-- Low to Normal -->

<transition>
<source ref="t1"/>
<target ref="t0"/>

<label kind="guard">
pump_state
</label>

<label kind="assignment">
tank_level = NORMAL
</label>

</transition>

<!-- Normal to High -->

<transition>
<source ref="t0"/>
<target ref="t2"/>

<label kind="guard">
pump_state
</label>

<label kind="assignment">
tank_level = HIGH
</label>

</transition>

<!-- High to Overflow -->

<transition>
<source ref="t2"/>
<target ref="t3"/>

<label kind="guard">
pump_state &amp;&amp; !safe_mode
</label>

<label kind="assignment">
tank_level = OVERFLOW
</label>

</transition>

</template>


<!-- ===================================================== -->
<!-- SENSOR                                                 -->
<!-- ===================================================== -->

<template>

<name>Sensor</name>

<declaration>
clock x;
</declaration>

<location id="s0">
<label kind="invariant">
x &lt;= Ts_max
</label>
</location>

<init ref="s0"/>

<transition>
<source ref="s0"/>
<target ref="s0"/>

<label kind="guard">
x &gt;= Ts_min
</label>

<label kind="synchronisation">
sensor_sample!
</label>

<label kind="assignment">
sensor_level = tank_level,
twin_estimate = tank_level,
x = 0
</label>

</transition>

</template>


<!-- ===================================================== -->
<!-- NETWORK                                                -->
<!-- ===================================================== -->

<template>

<name>Network</name>

<location id="n0">
<name>Operational</name>
</location>

<location id="n1">
<name>Blocked</name>
</location>

<init ref="n0"/>

<!-- Normal sensor transmission -->

<transition>
<source ref="n0"/>
<target ref="n0"/>

<label kind="guard">
!dos_active
&amp;&amp; !fdi_active
&amp;&amp; !replay_active
</label>

<label kind="synchronisation">
sensor_sample?
</label>

<label kind="synchronisation">
net_deliver_sensor!
</label>

<label kind="assignment">
secure_sensor_level = sensor_level
</label>

</transition>

<!-- False data injection -->

<transition>
<source ref="n0"/>
<target ref="n0"/>

<label kind="guard">
fdi_active &amp;&amp; !dos_active
</label>

<label kind="synchronisation">
sensor_sample?
</label>

<label kind="synchronisation">
net_deliver_sensor!
</label>

<label kind="assignment">
secure_sensor_level = LOW
</label>

</transition>

<!-- Replay attack -->

<transition>
<source ref="n0"/>
<target ref="n0"/>

<label kind="guard">
replay_active &amp;&amp; !dos_active
</label>

<label kind="synchronisation">
sensor_sample?
</label>

<label kind="synchronisation">
net_deliver_sensor!
</label>

<label kind="assignment">
secure_sensor_level = replay_buffer
</label>

</transition>

<!-- DoS activation -->

<transition>
<source ref="n0"/>
<target ref="n1"/>

<label kind="synchronisation">
dos_block?
</label>

<label kind="assignment">
dos_active = true
</label>

</transition>

<!-- DoS recovery -->

<transition>
<source ref="n1"/>
<target ref="n0"/>

<label kind="synchronisation">
dos_release?
</label>

<label kind="assignment">
dos_active = false
</label>

</transition>

</template>


<!-- ===================================================== -->
<!-- AI-BASED INTRUSION DETECTION SYSTEM                    -->
<!-- ===================================================== -->

<template>

<name>AI_IDS</name>

<location id="i0"/>

<init ref="i0"/>

<transition>
<source ref="i0"/>
<target ref="i0"/>

<label kind="synchronisation">
net_deliver_sensor?
</label>

<label kind="assignment">
intrusion_detected =
    (secure_sensor_level != sensor_level),

ai_alarm =
    (secure_sensor_level != sensor_level),

data_valid =
    (secure_sensor_level == sensor_level),

t_detect = 0,

clean_count =
    (secure_sensor_level == sensor_level
     ? clean_count + 1 : 0)
</label>

</transition>

</template>


<!-- ===================================================== -->
<!-- HUMAN OPERATOR                                         -->
<!-- ===================================================== -->

<template>

<name>Operator</name>

<location id="o0">
<name>Idle</name>
</location>

<location id="o1">
<name>Responding</name>
<label kind="invariant">
t_response &lt;= Tr_max
</label>
</location>

<init ref="o0"/>

<!-- Start response after AI alarm -->

<transition>
<source ref="o0"/>
<target ref="o1"/>

<label kind="guard">
ai_alarm
</label>

<label kind="assignment">
t_response = 0
</label>

</transition>

<!-- Complete operator response -->

<transition>
<source ref="o1"/>
<target ref="o0"/>

<label kind="guard">
t_response &gt;= Tr_max
</label>

<label kind="assignment">
operator_ack = true,
ai_alarm = false
</label>

</transition>

</template>


<!-- ===================================================== -->
<!-- SAFE MODE CONTROLLER                                   -->
<!-- ===================================================== -->

<template>

<name>SafeMode</name>

<location id="sm0">
<name>Normal</name>
</location>

<location id="sm1">
<name>Safe</name>
</location>

<init ref="sm0"/>

<!-- Detection-based safe-mode activation -->

<transition>
<source ref="sm0"/>
<target ref="sm1"/>

<label kind="guard">
intrusion_detected &amp;&amp; t_detect &lt;= Td_max
</label>

<label kind="assignment">
safe_mode = true,
pump_state = false,
pump_cmd_on = false,
pump_cmd_off = false
</label>

</transition>

<!-- Human-based safe-mode activation -->

<transition>
<source ref="sm0"/>
<target ref="sm1"/>

<label kind="guard">
operator_ack
</label>

<label kind="assignment">
safe_mode = true,
pump_state = false,
pump_cmd_on = false,
pump_cmd_off = false
</label>

</transition>

<!-- Recovery after clean communication measurements -->

<transition>
<source ref="sm1"/>
<target ref="sm0"/>

<label kind="guard">
clean_count &gt;= RECOVERY_THRESHOLD
&amp;&amp; !dos_active
</label>

<label kind="assignment">
safe_mode = false,
intrusion_detected = false,
ai_alarm = false,
operator_ack = false,
data_valid = true,
clean_count = 0
</label>

</transition>

</template>


<!-- ===================================================== -->
<!-- PLC                                                    -->
<!-- ===================================================== -->

<template>

<name>PLC</name>

<location id="p0"/>

<init ref="p0"/>

<!-- Pump ON -->

<transition>
<source ref="p0"/>
<target ref="p0"/>

<label kind="guard">
!safe_mode
&amp;&amp; data_valid
&amp;&amp; secure_sensor_level &lt;= LOWER_THRESHOLD
</label>

<label kind="assignment">
pump_cmd_on = true,
pump_cmd_off = false
</label>

</transition>

<!-- Pump OFF -->

<transition>
<source ref="p0"/>
<target ref="p0"/>

<label kind="guard">
secure_sensor_level &gt;= UPPER_THRESHOLD
|| safe_mode
</label>

<label kind="assignment">
pump_cmd_on = false,
pump_cmd_off = true
</label>

</transition>

</template>


<!-- ===================================================== -->
<!-- PUMP ACTUATOR                                          -->
<!-- ===================================================== -->

<template>

<name>Pump</name>

<location id="a0"/>

<init ref="a0"/>

<!-- Safe-mode override -->

<transition>
<source ref="a0"/>
<target ref="a0"/>

<label kind="guard">
safe_mode
</label>

<label kind="assignment">
pump_state = false,
pump_cmd_on = false,
pump_cmd_off = false
</label>

</transition>

<!-- Execute pump ON -->

<transition>
<source ref="a0"/>
<target ref="a0"/>

<label kind="guard">
pump_cmd_on &amp;&amp; !safe_mode
</label>

<label kind="assignment">
pump_state = true,
pump_cmd_on = false
</label>

</transition>

<!-- Execute pump OFF -->

<transition>
<source ref="a0"/>
<target ref="a0"/>

<label kind="guard">
pump_cmd_off || safe_mode
</label>

<label kind="assignment">
pump_state = false,
pump_cmd_off = false
</label>

</transition>

</template>


<!-- ===================================================== -->
<!-- FDI ATTACKER                                           -->
<!-- ===================================================== -->

<template>

<name>FDI_Attacker</name>

<location id="f0">
<name>Idle</name>
</location>

<init ref="f0"/>

<transition>
<source ref="f0"/>
<target ref="f0"/>

<label kind="synchronisation">
fdi_trigger!
</label>

<label kind="assignment">
fdi_active = true
</label>

</transition>

</template>


<!-- ===================================================== -->
<!-- REPLAY ATTACKER                                        -->
<!-- ===================================================== -->

<template>

<name>Replay_Attacker</name>

<location id="r0">
<name>Idle</name>
</location>

<init ref="r0"/>

<!-- Capture the latest sampled measurement -->

<transition>
<source ref="r0"/>
<target ref="r0"/>

<label kind="synchronisation">
sensor_sample?
</label>

<label kind="assignment">
replay_buffer = sensor_level
</label>

</transition>

<!-- Activate replay -->

<transition>
<source ref="r0"/>
<target ref="r0"/>

<label kind="synchronisation">
replay_trigger!
</label>

<label kind="assignment">
replay_active = true
</label>

</transition>

</template>


<!-- ===================================================== -->
<!-- DOS ATTACKER                                           -->
<!-- ===================================================== -->

<template>

<name>DoS_Attacker</name>

<location id="d0">
<name>Idle</name>
</location>

<init ref="d0"/>

<transition>
<source ref="d0"/>
<target ref="d0"/>

<label kind="synchronisation">
dos_block!
</label>

</transition>

</template>


<!-- ===================================================== -->
<!-- SYSTEM INSTANTIATION                                   -->
<!-- ===================================================== -->

<system>

tank = Tank();
sensor = Sensor();
network = Network();
ids = AI_IDS();
operator = Operator();
safe = SafeMode();
plc = PLC();
pump = Pump();

fdi = FDI_Attacker();
replay = Replay_Attacker();
dos = DoS_Attacker();

system tank,
       sensor,
       network,
       ids,
       operator,
       safe,
       plc,
       pump,
       fdi,
       replay,
       dos;

</system>


<!-- ===================================================== -->
<!-- ORIGINAL VERIFICATION QUERIES                          -->
<!-- ===================================================== -->

<queries>

<query>
<formula>A[] safe_mode imply tank_level != OVERFLOW</formula>
<comment>
Conditional safety: overflow must not coexist with safe mode.
</comment>
</query>

<query>
<formula>E&lt;&gt; tank.Overflow</formula>
<comment>
Overflow reachability under the attack-enabled model.
</comment>
</query>

<query>
<formula>E&lt;&gt; ai_alarm</formula>
<comment>
AI intrusion detection is reachable.
</comment>
</query>

<query>
<formula>E&lt;&gt; operator_ack</formula>
<comment>
Human operator acknowledgement is reachable.
</comment>
</query>

<query>
<formula>A[] !(pump_cmd_on &amp;&amp; pump_cmd_off)</formula>
<comment>
Pump command mutual exclusion.
</comment>
</query>

</queries>

</nta>
