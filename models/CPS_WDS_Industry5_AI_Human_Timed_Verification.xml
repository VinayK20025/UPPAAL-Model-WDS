<?xml version='1.0' encoding='utf-8'?>
<nta>





<declaration>

const int DEPLETED = 0;
const int LOW      = 1;
const int NORMAL   = 2;
const int HIGH     = 3;
const int OVERFLOW = 4;

/* Physical system and digital twin */

int tank_level = NORMAL;
int sensor_level = NORMAL;
int secure_sensor_level = NORMAL;
int twin_estimate = NORMAL;

/* Control */

bool pump_state = false;
bool pump_cmd_on = false;
bool pump_cmd_off = false;

/* Security and AI monitoring */

bool intrusion_detected = false;
bool ai_alarm = false;
bool operator_ack = false;
bool safe_mode = false;
bool data_valid = true;
bool measurement_pending = false;
bool control_inhibit = false;

/* Attack flags */

bool fdi_active = false;
bool replay_active = false;
bool dos_active = false;

/* Replay buffer */

int replay_buffer = NORMAL;

/* FDI configuration */

const int FDI_INJECTED_LEVEL = LOW;

/* Timed detection and response */

clock t_detect;
clock t_response;

const int Td_max = 5;
const int Tr_max = 3;

/* Thresholds */

const int LOWER_THRESHOLD = LOW;
const int UPPER_THRESHOLD = HIGH;

/* Communication channels */

chan sensor_sample;
chan net_deliver_sensor;

chan dos_block;
chan dos_release;

/* Sampling period */

const int Ts_min = 1;
const int Ts_max = 5;

/* Recovery monitoring */

int clean_count = 0;
const int RECOVERY_THRESHOLD = 3;


bool overflow_during_interlock = false;

bool recovery_completed = false;
</declaration>






<template>

<name>Tank</name>

<location id="t0">
<name>Normal</name>
</location>

<location id="t1">
<name>Low</name>
</location>

<location id="t2">
<name>High</name>
</location>

<location id="t3">
<name>Overflow</name>
</location>

<init ref="t0" />



<transition>
<source ref="t0" />
<target ref="t1" />

<label kind="guard">
!pump_state
</label>

<label kind="assignment">
tank_level = LOW
</label>

</transition>



<transition>
<source ref="t1" />
<target ref="t0" />

<label kind="guard">
pump_state
</label>

<label kind="assignment">
tank_level = NORMAL
</label>

</transition>



<transition>
<source ref="t0" />
<target ref="t2" />

<label kind="guard">
pump_state
</label>

<label kind="assignment">
tank_level = HIGH
</label>

</transition>



<transition>
<source ref="t2" />
<target ref="t3" />

<label kind="guard">
pump_state &amp;&amp; !safe_mode &amp;&amp; !control_inhibit
</label>

<label kind="assignment">
tank_level = OVERFLOW,
overflow_during_interlock = control_inhibit
</label>

</transition>

</template>






<template>

<name>Sensor</name>

<declaration>
clock x;
</declaration>

<location id="s0">
<name>Sampling</name>

<label kind="invariant">
x &lt;= Ts_max
</label>

</location>

<init ref="s0" />

<transition>
<source ref="s0" />
<target ref="s0" />

<label kind="guard">
x &gt;= Ts_min
</label>

<label kind="synchronisation">
sensor_sample!
</label>

<label kind="assignment">
sensor_level = tank_level,
twin_estimate = tank_level,
x = 0
</label>

</transition>

</template>






<template>

<name>Network</name>

<location id="n0">
<name>Operational</name>
</location>

<location id="n1">
<name>Received</name>
</location>

<location id="n2">
<name>Deliver</name>
</location>

<location id="n3">
<name>Blocked</name>
</location>

<init ref="n0" />



<transition>
<source ref="n0" />
<target ref="n1" />

<label kind="synchronisation">
sensor_sample?
</label>

<label kind="assignment">
measurement_pending = true
</label>

</transition>



<transition>
<source ref="n1" />
<target ref="n2" />

<label kind="guard">
fdi_active &amp;&amp; !dos_active
</label>

<label kind="assignment">
secure_sensor_level = FDI_INJECTED_LEVEL
</label>

</transition>



<transition>
<source ref="n1" />
<target ref="n2" />

<label kind="guard">
!fdi_active
&amp;&amp; replay_active
&amp;&amp; !dos_active
</label>

<label kind="assignment">
secure_sensor_level = replay_buffer
</label>

</transition>



<transition>
<source ref="n1" />
<target ref="n2" />

<label kind="guard">
!fdi_active
&amp;&amp; !replay_active
&amp;&amp; !dos_active
</label>

<label kind="assignment">
secure_sensor_level = sensor_level
</label>

</transition>



<transition>
<source ref="n2" />
<target ref="n0" />

<label kind="synchronisation">
net_deliver_sensor!
</label>

</transition>



<transition>
<source ref="n0" />
<target ref="n3" />

<label kind="synchronisation">
dos_block?
</label>

<label kind="assignment">
dos_active = true,
control_inhibit = true,
data_valid = false,
clean_count = 0
</label>

</transition>



<transition>
<source ref="n3" />
<target ref="n0" />

<label kind="synchronisation">
dos_release?
</label>

<label kind="assignment">
dos_active = false,
data_valid = false,
clean_count = 0
</label>

</transition>

</template>






<template>

<name>AI_IDS</name>

<location id="i0">
<name>Monitoring</name>
</location>

<init ref="i0" />

<transition>
<source ref="i0" />
<target ref="i0" />

<label kind="synchronisation">
net_deliver_sensor?
</label>

<label kind="assignment">
intrusion_detected =
    intrusion_detected ||
    (secure_sensor_level != sensor_level),

ai_alarm =
    ai_alarm ||
    (secure_sensor_level != sensor_level),

data_valid =
    (secure_sensor_level == sensor_level),

t_detect = 0,

clean_count =
    (secure_sensor_level == sensor_level
     ? (clean_count &lt; RECOVERY_THRESHOLD
        ? clean_count + 1
        : RECOVERY_THRESHOLD)
     : 0),
measurement_pending = false
</label>

</transition>

</template>






<template>

<name>Operator</name>

<declaration>
clock response_clock;
</declaration>

<location id="o0">
<name>Idle</name>
</location>

<location id="o1">
<name>Responding</name>

<label kind="invariant">
response_clock &lt;= Tr_max
</label>

</location>

<init ref="o0" />



<transition>
<source ref="o0" />
<target ref="o1" />

<label kind="guard">
ai_alarm &amp;&amp; !operator_ack
</label>

<label kind="assignment">
response_clock = 0,
t_response = 0
</label>

</transition>



<transition>
<source ref="o1" />
<target ref="o0" />

<label kind="guard">
response_clock &gt;= Tr_max
</label>

<label kind="assignment">
operator_ack = true,
ai_alarm = false
</label>

</transition>

</template>






<template>

<name>SafeMode</name>

<location id="sm0">
<name>Normal</name>
</location>

<location id="sm1">
<name>Safe</name>
</location>

<init ref="sm0" />



<transition>
<source ref="sm0" />
<target ref="sm1" />

<label kind="guard">
control_inhibit &amp;&amp; tank_level != OVERFLOW
</label>

<label kind="assignment">
safe_mode = true,
pump_state = false,
pump_cmd_on = false,
pump_cmd_off = false
</label>

</transition>



<transition>
<source ref="sm0" />
<target ref="sm1" />

<label kind="guard">
intrusion_detected &amp;&amp; t_detect &lt;= Td_max
&amp;&amp; tank_level != OVERFLOW
</label>

<label kind="assignment">
safe_mode = true,
pump_state = false,
pump_cmd_on = false,
pump_cmd_off = false
</label>

</transition>



<transition>
<source ref="sm0" />
<target ref="sm1" />

<label kind="guard">
operator_ack &amp;&amp; tank_level != OVERFLOW
</label>

<label kind="assignment">
safe_mode = true,
pump_state = false,
pump_cmd_on = false,
pump_cmd_off = false
</label>

</transition>



<transition>
<source ref="sm1" />
<target ref="sm0" />

<label kind="guard">
clean_count &gt;= RECOVERY_THRESHOLD
&amp;&amp; !dos_active
&amp;&amp; !fdi_active
&amp;&amp; !replay_active
</label>

<label kind="assignment">safe_mode = false,
control_inhibit = false,
intrusion_detected = false,
ai_alarm = false,
operator_ack = false,
data_valid = true,
clean_count = 0,
recovery_completed = true
</label>

</transition>

</template>






<template>

<name>PLC</name>

<location id="p0">
<name>Control</name>
</location>

<init ref="p0" />



<transition>
<source ref="p0" />
<target ref="p0" />

<label kind="guard">
!safe_mode
&amp;&amp; !control_inhibit
&amp;&amp; !measurement_pending
&amp;&amp; data_valid
&amp;&amp; !intrusion_detected
&amp;&amp; !ai_alarm
&amp;&amp; secure_sensor_level &lt;= LOWER_THRESHOLD
</label>

<label kind="assignment">
pump_cmd_on = true,
pump_cmd_off = false
</label>

</transition>



<transition>
<source ref="p0" />
<target ref="p0" />

<label kind="guard">
safe_mode
|| control_inhibit
|| (!measurement_pending
    &amp;&amp; secure_sensor_level &gt;= UPPER_THRESHOLD)
</label>

<label kind="assignment">
pump_cmd_on = false,
pump_cmd_off = true
</label>

</transition>

</template>






<template>

<name>Pump</name>

<location id="a0">
<name>Actuator</name>
</location>

<init ref="a0" />



<transition>
<source ref="a0" />
<target ref="a0" />

<label kind="guard">
safe_mode || control_inhibit
</label>

<label kind="assignment">
pump_state = false,
pump_cmd_on = false,
pump_cmd_off = false
</label>

</transition>



<transition>
<source ref="a0" />
<target ref="a0" />

<label kind="guard">
pump_cmd_on &amp;&amp; !safe_mode &amp;&amp; !control_inhibit
</label>

<label kind="assignment">
pump_state = true,
pump_cmd_on = false
</label>

</transition>



<transition>
<source ref="a0" />
<target ref="a0" />

<label kind="guard">
pump_cmd_off || safe_mode || control_inhibit
</label>

<label kind="assignment">
pump_state = false,
pump_cmd_off = false
</label>

</transition>

</template>






<template>

<name>FDI_Attacker</name>

<declaration>
clock x;
</declaration>

<location id="f0">
<name>Idle</name>

<label kind="invariant">
x &lt;= 4
</label>

</location>

<location id="f1">
<name>Active</name>

<label kind="invariant">
x &lt;= 4
</label>

</location>

<init ref="f0" />



<transition>
<source ref="f0" />
<target ref="f1" />

<label kind="guard">
x &gt;= 2
</label>

<label kind="assignment">
fdi_active = true,
control_inhibit = true,
data_valid = false,
clean_count = 0,
x = 0
</label>

</transition>



<transition>
<source ref="f1" />
<target ref="f0" />

<label kind="guard">
x &gt;= 2
</label>

<label kind="assignment">
fdi_active = false,
data_valid = false,
clean_count = 0,
x = 0
</label>

</transition>

</template>






<template>

<name>Replay_Attacker</name>

<declaration>
clock x;
</declaration>

<location id="r0">
<name>Idle</name>

<label kind="invariant">
x &lt;= 6
</label>

</location>

<location id="r1">
<name>Active</name>

<label kind="invariant">
x &lt;= 4
</label>

</location>

<init ref="r0" />



<transition>
<source ref="r0" />
<target ref="r1" />

<label kind="guard">
x &gt;= 3
</label>

<label kind="assignment">
replay_active = true,
control_inhibit = true,
data_valid = false,
clean_count = 0,
x = 0
</label>

</transition>



<transition>
<source ref="r1" />
<target ref="r0" />

<label kind="guard">
x &gt;= 2
</label>

<label kind="assignment">
replay_active = false,
data_valid = false,
clean_count = 0,
x = 0
</label>

</transition>

</template>






<template>

<name>DoS_Attacker</name>

<declaration>
clock x;
</declaration>

<location id="d0">
<name>Idle</name>

<label kind="invariant">
x &lt;= 7
</label>

</location>

<location id="d1">
<name>Active</name>

<label kind="invariant">
x &lt;= 3
</label>

</location>

<init ref="d0" />



<transition>
<source ref="d0" />
<target ref="d1" />

<label kind="guard">
x &gt;= 4
</label>

<label kind="synchronisation">
dos_block!
</label>

<label kind="assignment">
x = 0
</label>

</transition>



<transition>
<source ref="d1" />
<target ref="d0" />

<label kind="guard">
x &gt;= 2
</label>

<label kind="synchronisation">
dos_release!
</label>

<label kind="assignment">
x = 0
</label>

</transition>

</template>






<system>

tank = Tank();
sensor = Sensor();
network = Network();
ids = AI_IDS();
operator = Operator();
safe = SafeMode();
plc = PLC();
pump = Pump();

fdi = FDI_Attacker();
replay = Replay_Attacker();
dos = DoS_Attacker();

system tank,
       sensor,
       network,
       ids,
       operator,
       safe,
       plc,
       pump,
       fdi,
       replay,
       dos;

</system>






<queries>

<query>
<formula>A[] safe_mode imply tank_level != OVERFLOW</formula>
<comment>
Conditional safety: overflow must not coexist with safe mode.
</comment>
</query>

<query>
<formula>E&lt;&gt; tank.Overflow</formula>
<comment>
Overflow reachability under the attack-enabled model.
</comment>
</query>

<query>
<formula>E&lt;&gt; ai_alarm</formula>
<comment>
AI intrusion detection is reachable.
</comment>
</query>

<query>
<formula>E&lt;&gt; operator_ack</formula>
<comment>
Human operator acknowledgement is reachable.
</comment>
</query>

<query>
<formula>A[] !(pump_cmd_on &amp;&amp; pump_cmd_off)</formula>
<comment>
Pump command mutual exclusion.
</comment>
</query>

</queries>

</nta>