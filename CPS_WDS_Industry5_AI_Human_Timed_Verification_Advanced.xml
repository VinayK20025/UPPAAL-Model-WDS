	<declaration>
/* ---------- (A) System configuration ---------- */
const int N = 2;                 // number of tanks (paper: N = 2)

const int EMPTY    = 0;
const int LOW      = 1;
const int NORMAL    = 2;
const int HIGH     = 3;
const int OVERFLOW = 4;

const int LOWER_THRESHOLD = LOW;
const int UPPER_THRESHOLD = HIGH;

const int FLOW_NOMINAL = 1;      // nominal flow unit when pump is ON

/* ---------- (B) Physical / sensing / control state ---------- */
int  tank_level[2]            = {NORMAL, NORMAL};
bool pump_state[2]            = {false, false};
int  sensor_level[2]          = {NORMAL, NORMAL};
int  secure_sensor_level[2]   = {NORMAL, NORMAL};
int  replay_buffer[2]         = {NORMAL, NORMAL};
bool pump_cmd_on[2]           = {false, false};
bool pump_cmd_off[2]          = {false, false};
int  flow_level[2]            = {0, 0};

/* ---------- (C) Digital Twin state ---------- */
int  twin_estimate[2]         = {NORMAL, NORMAL};
bool twin_error[2]            = {false, false};
int  twin_sync_count[2]       = {0, 0};
int  twin_mismatch_count[2]   = {0, 0};   // persistence counter (private to twin logic)

/* ---------- (D) Security state ---------- */
bool intrusion_detected = false;
bool ai_alarm           = false;
bool operator_ack       = false;
bool safe_mode          = false;
bool backup_shutdown    = false;

/* ---------- (E) Adversary / attack state ---------- */
bool fdi_active     = false;
bool replay_active  = false;
bool dos_active     = false;
bool cmdinj_active  = false;     // command-injection attack flag
int  target_id      = 0;         // tank currently targeted by the adversary
int  attack_intensity = 0;       // 1..5, severity level (Table "Parameters")

/* ---------- (F) Resilience / recovery / liveness state ---------- */
int  clean_count    = 0;
int  watchdog_miss  = 0;

/* ---------- (G) Timing parameters ---------- */
const int T_PHYS_MIN = 2,  T_PHYS_MAX = 4;     // physical-layer evolution period
const int Ts_min      = 1,  Ts_max      = 3;    // sensor sampling period
const int Tf_min      = 1,  Tf_max      = 3;    // flow-sensor sampling period
const int Tn_min      = 1,  Tn_max      = 3;    // communication-layer period
const int Tw_min      = 0,  Tw_max      = 4;    // digital-twin evaluation period
const int Td_max      = 8;                      // detection budget (T_detect bound)
const int Tr_min      = 1,  Tr_max      = 5;    // operator response window
const int T_attack_min     = 2;                 // min wait before adversary activates
const int T_attack_dur_min = 2, T_attack_dur_max = 6; // attack sustain duration
const int T_recovery_min   = 2, T_recovery_max   = 6; // recovery stabilisation period
const int WD_min = 1, WD_max = 4;               // watchdog heartbeat bounds
const int WD_LIMIT   = 3;                       // missed-heartbeat tolerance
const int THETA_TWIN  = 2;                      // mismatch persistence threshold
const int THETA_CLEAN = 3;                      // clean observations to exit safe mode

/* Clocks shared across automata (named exactly as in the manuscript) */
clock t_detect;
clock t_response;
clock heartbeat;

/* ---------- (H) Channels ---------- */
broadcast chan sensor_sample[2];
broadcast chan flow_sample[2];
broadcast chan net_deliver[2];
broadcast chan start[2];
broadcast chan stop[2];
broadcast chan alarm;
broadcast chan attack_start;
broadcast chan attack_end;
broadcast chan backup_trig;
broadcast chan safe_trig;

/* ---------- (I) Helper functions ----------
   Centralising the detection predicate and the safety-condition check keeps
   guards on edges short, auditable, and consistent with the abstract
   IDS contract described in Section "Limitations of the Abstract AI
   Representation": Observed State -&gt; Detection Predicate -&gt; Alarm Signal.
*/

// Digital-twin prediction step (per-tank state-estimation update).
void predict_twin(int id) {
    if (pump_state[id]) {
        if (twin_estimate[id] &lt; OVERFLOW) {
            twin_estimate[id] = twin_estimate[id] + 1;
        }
    } else {
        if (twin_estimate[id] &gt; EMPTY) {
            twin_estimate[id] = twin_estimate[id] - 1;
        }
    }
}

// Digital-twin residual / consistency-check step with temporal filtering
// (sustained-deviation counter), matching Section "AI-Based Detection and
// Defence Mechanisms": "Temporal filtering mechanisms ... reduce false
// positives by requiring sustained deviations before raising alarms."
void update_twin(int id) {
    if (twin_estimate[id] == secure_sensor_level[id]) {
        twin_mismatch_count[id] = 0;
        twin_error[id] = false;
        if (twin_sync_count[id] &lt; 100) {
            twin_sync_count[id] = twin_sync_count[id] + 1;
        }
    } else {
        twin_mismatch_count[id] = twin_mismatch_count[id] + 1;
        twin_sync_count[id] = 0;
        if (twin_mismatch_count[id] &gt;= THETA_TWIN) {
            twin_error[id] = true;
        }
    }
}

// Abstract IDS detection predicate: combines digital-twin residuals,
// communication-layer evidence, and attack-flag variables, without
// reference to any specific ML/statistical algorithm (Section 5.9 / Limitations 8.8).
bool detect_predicate() {
    return twin_error[0] || twin_error[1] || fdi_active || replay_active || dos_active || cmdinj_active;
}

// True if any tank has reached the OVERFLOW state.
bool any_overflow() {
    return (tank_level[0] == OVERFLOW) || (tank_level[1] == OVERFLOW);
}
