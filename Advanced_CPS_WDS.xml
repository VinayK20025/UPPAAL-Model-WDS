<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.6//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_6.dtd'>
<nta>
	<declaration>

/* ==================== SYSTEM SCALE ==================== */
const int N = 2;

/* ==================== LEVEL ENCODING ==================== */
const int EMPTY    = 0;
const int LOW      = 1;
const int NORMAL   = 2;
const int HIGH     = 3;
const int OVERFLOW = 4;

/* ==================== RECOVERY POLICY ==================== */
const int RECOVERY_THRESHOLD = 3;
const int MAX_RECOVERY_TIME  = 10;
const int FLOW               = 1;

/* ==================== PHYSICAL LAYER ==================== */
int[0,4] tank_level[N];

/* ==================== SENSOR LAYER ==================== */
int[0,4] sensor_level[N];
int[0,4] secure_sensor_level[N];
int[0,4] replay_buffer[N];

/* ==================== DIGITAL TWIN ==================== */
int[0,4] twin_estimate[N];
bool     twin_error[N];
int[0,5] twin_sync_count[N];

/* ==================== CONTROL LAYER ==================== */
bool pump_state[N];
bool pump_cmd_on[N];
bool pump_cmd_off[N];

/* ==================== SECURITY STATE ==================== */
bool intrusion_detected = false;
bool ai_alarm           = false;
bool operator_ack       = false;
bool safe_mode          = false;
bool backup_shutdown    = false;

/* ==================== ATTACK STATE ==================== */
bool   fdi_active    = false;
bool   replay_active = false;
bool   dos_active    = false;
int[0,3] attack_intensity[3];

/* ==================== RECOVERY COUNTER ==================== */
int[0,RECOVERY_THRESHOLD] clean_count = 0;

/* ==================== CLOCKS ==================== */
clock t_detect;
clock t_response;
clock heartbeat;
clock recovery_time;

/* ==================== CHANNELS ==================== */
chan sensor_sample;
chan net_sensor;
chan net_control;
chan log_event;
chan heartbeat_tick;
chan recovery_start;

</declaration>
	<template>
		<name>Tank</name>
		<parameter>int id</parameter>
		<location id="id0" x="40" y="80">
		</location>
		<location id="id1" x="190" y="80">
		</location>
		<location id="id2" x="190" y="230">
		</location>
		<location id="id3" x="40" y="230">
		</location>
		<init ref="id0"/>
		<transition id="id4">
			<source ref="id0"/>
			<target ref="id1"/>
			<label kind="assignment" x="55" y="80">tank_level[id] = NORMAL</label>
		</transition>
		<transition id="id5">
			<source ref="id1"/>
			<target ref="id2"/>
			<label kind="guard" x="130" y="125">pump_state[id] &amp;&amp; tank_level[id] &gt;= HIGH</label>
			<label kind="assignment" x="130" y="155">tank_level[id] = (tank_level[id] &lt; OVERFLOW ? tank_level[id] + FLOW : OVERFLOW)</label>
		</transition>
		<transition id="id6">
			<source ref="id1"/>
			<target ref="id1"/>
			<label kind="guard" x="130" y="50">pump_state[id] &amp;&amp; tank_level[id] &lt; HIGH</label>
			<label kind="assignment" x="130" y="80">tank_level[id] = (tank_level[id] &lt; OVERFLOW ? tank_level[id] + FLOW : OVERFLOW)</label>
			<nail x="160" y="50"/>
			<nail x="220" y="50"/>
		</transition>
		<transition id="id7">
			<source ref="id1"/>
			<target ref="id1"/>
			<label kind="guard" x="130" y="50">!pump_state[id] &amp;&amp; tank_level[id] &gt; LOW</label>
			<label kind="assignment" x="130" y="80">tank_level[id] = (tank_level[id] &gt; 0 ? tank_level[id] - FLOW : EMPTY)</label>
			<nail x="160" y="50"/>
			<nail x="220" y="50"/>
		</transition>
		<transition id="id8">
			<source ref="id2"/>
			<target ref="id3"/>
			<label kind="guard" x="55" y="200">tank_level[id] == OVERFLOW</label>
		</transition>
		<transition id="id9">
			<source ref="id2"/>
			<target ref="id1"/>
			<label kind="guard" x="130" y="125">!pump_state[id] &amp;&amp; tank_level[id] &lt; HIGH</label>
			<label kind="assignment" x="130" y="155">tank_level[id] = (tank_level[id] &gt; 0 ? tank_level[id] - FLOW : EMPTY)</label>
		</transition>
		<transition id="id10">
			<source ref="id3"/>
			<target ref="id3"/>
			<label kind="guard" x="-20" y="200">tank_level[id] == OVERFLOW</label>
			<nail x="10" y="200"/>
			<nail x="70" y="200"/>
		</transition>
		<transition id="id11">
			<source ref="id3"/>
			<target ref="id1"/>
			<label kind="guard" x="55" y="125">tank_level[id] &lt; HIGH &amp;&amp; safe_mode</label>
			<label kind="assignment" x="55" y="155">tank_level[id] = NORMAL</label>
		</transition>
	</template>
