<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.6//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_6.dtd'>
<nta>
	<declaration>
const int DEPLETED = 0;
const int LOW      = 1;
const int NORMAL   = 2;
const int HIGH     = 3;
const int OVERFLOW = 4;

/* Physical */
int tank_level   = NORMAL;
int sensor_level = NORMAL;
int secure_sensor_level = NORMAL;

/* Control */
bool pump_state   = false;
bool pump_cmd_on  = false;
bool pump_cmd_off = false;

/* Security */
bool intrusion_detected = false;
bool data_valid         = true;

/* Attack flags */
bool fdi_active   = false;
bool replay_active = false;
bool dos_active   = false;

/* Replay buffer */
int replay_buffer = NORMAL;

/* Thresholds */
const int LOWER_THRESHOLD = LOW;
const int UPPER_THRESHOLD = HIGH;

/* Channels */
chan sensor_sample;
chan net_deliver_sensor;
chan plc_to_actuator;
chan net_deliver_cmd;

/* Attack channels */
chan fdi_trigger;
chan replay_trigger;
chan dos_block;
chan dos_release;

/* Timing */
const int Ts_min = 1, Ts_max = 5;
</declaration>
	<template>
		<name>Tank</name>
		<location id="id0" x="40" y="80">
			<name x="30" y="50">Normal</name>
		</location>
		<location id="id1" x="190" y="80">
			<name x="180" y="50">Low</name>
		</location>
		<location id="id2" x="190" y="230">
			<name x="180" y="200">High</name>
		</location>
		<location id="id3" x="40" y="230">
			<name x="30" y="200">Overflow</name>
		</location>
		<init ref="id0"/>
		<transition id="id4">
			<source ref="id0"/>
			<target ref="id1"/>
			<label kind="guard" x="55" y="50">!pump_state</label>
			<label kind="assignment" x="55" y="80">tank_level = LOW</label>
		</transition>
		<transition id="id5">
			<source ref="id1"/>
			<target ref="id0"/>
			<label kind="guard" x="55" y="50">pump_state</label>
			<label kind="assignment" x="55" y="80">tank_level = NORMAL</label>
		</transition>
		<transition id="id6">
			<source ref="id0"/>
			<target ref="id2"/>
			<label kind="guard" x="55" y="125">pump_state</label>
			<label kind="assignment" x="55" y="155">tank_level = HIGH</label>
		</transition>
		<transition id="id7">
			<source ref="id2"/>
			<target ref="id3"/>
			<label kind="guard" x="55" y="200">pump_state</label>
			<label kind="assignment" x="55" y="230">tank_level = OVERFLOW</label>
		</transition>
	</template>
	<template>
		<name>Sensor</name>
		<declaration>clock x;</declaration>
		<location id="id8" x="40" y="80">
			<label kind="invariant" x="30" y="95">x &lt;= Ts_max</label>
		</location>
		<init ref="id8"/>
		<transition id="id9">
			<source ref="id8"/>
			<target ref="id8"/>
			<label kind="guard" x="-20" y="50">x &gt;= Ts_min</label>
			<label kind="synchronisation" x="-20" y="65">sensor_sample!</label>
			<label kind="assignment" x="-20" y="80">sensor_level = tank_level, x = 0</label>
			<nail x="10" y="50"/>
			<nail x="70" y="50"/>
		</transition>
	</template>
	<template>
		<name>Network</name>
		<location id="id10" x="40" y="80">
		</location>
		<location id="id11" x="190" y="80">
			<name x="180" y="50">Blocked</name>
		</location>
		<init ref="id10"/>
		<transition id="id12">
			<source ref="id10"/>
			<target ref="id10"/>
			<label kind="guard" x="-20" y="50">!dos_active</label>
			<label kind="synchronisation" x="-20" y="65">net_deliver_sensor!</label>
			<label kind="assignment" x="-20" y="80">secure_sensor_level = sensor_level</label>
			<nail x="10" y="50"/>
			<nail x="70" y="50"/>
		</transition>
		<transition id="id13">
			<source ref="id10"/>
			<target ref="id10"/>
			<label kind="guard" x="-20" y="50">fdi_active &amp;&amp; !dos_active</label>
			<label kind="synchronisation" x="-20" y="65">net_deliver_sensor!</label>
			<label kind="assignment" x="-20" y="80">secure_sensor_level = LOW</label>
			<nail x="10" y="50"/>
			<nail x="70" y="50"/>
		</transition>
		<transition id="id14">
			<source ref="id10"/>
			<target ref="id10"/>
			<label kind="guard" x="-20" y="50">replay_active &amp;&amp; !dos_active</label>
			<label kind="synchronisation" x="-20" y="65">net_deliver_sensor!</label>
			<label kind="assignment" x="-20" y="80">secure_sensor_level = replay_buffer</label>
			<nail x="10" y="50"/>
			<nail x="70" y="50"/>
		</transition>
		<transition id="id15">
			<source ref="id10"/>
			<target ref="id11"/>
			<label kind="synchronisation" x="55" y="65">dos_block?</label>
		</transition>
		<transition id="id16">
			<source ref="id11"/>
			<target ref="id10"/>
			<label kind="synchronisation" x="55" y="65">dos_release?</label>
		</transition>
	</template>
	<template>
		<name>IDS</name>
		<location id="id17" x="40" y="80">
		</location>
		<init ref="id17"/>
		<transition id="id18">
			<source ref="id17"/>
			<target ref="id17"/>
			<label kind="synchronisation" x="-20" y="65">net_deliver_sensor?</label>
			<label kind="assignment" x="-20" y="80">intrusion_detected = (secure_sensor_level != tank_level),
      data_valid = (secure_sensor_level == tank_level)</label>
			<nail x="10" y="50"/>
			<nail x="70" y="50"/>
		</transition>
	</template>
	<template>
		<name>PLC</name>
		<location id="id19" x="40" y="80">
		</location>
		<init ref="id19"/>
		<transition id="id20">
			<source ref="id19"/>
			<target ref="id19"/>
			<label kind="guard" x="-20" y="50">data_valid &amp;&amp; secure_sensor_level &lt;= LOWER_THRESHOLD</label>
			<label kind="assignment" x="-20" y="80">pump_cmd_on = true,
      pump_cmd_off = false</label>
			<nail x="10" y="50"/>
			<nail x="70" y="50"/>
		</transition>
		<transition id="id21">
			<source ref="id19"/>
			<target ref="id19"/>
			<label kind="guard" x="-20" y="50">secure_sensor_level &gt;= UPPER_THRESHOLD</label>
			<label kind="assignment" x="-20" y="80">pump_cmd_on = false,
      pump_cmd_off = true</label>
			<nail x="10" y="50"/>
			<nail x="70" y="50"/>
		</transition>
	</template>
	<template>
		<name>Pump</name>
		<location id="id22" x="40" y="80">
		</location>
		<init ref="id22"/>
		<transition id="id23">
			<source ref="id22"/>
			<target ref="id22"/>
			<label kind="guard" x="-20" y="50">pump_cmd_on</label>
			<label kind="assignment" x="-20" y="80">pump_state = true, pump_cmd_on = false</label>
			<nail x="10" y="50"/>
			<nail x="70" y="50"/>
		</transition>
		<transition id="id24">
			<source ref="id22"/>
			<target ref="id22"/>
			<label kind="guard" x="-20" y="50">pump_cmd_off</label>
			<label kind="assignment" x="-20" y="80">pump_state = false, pump_cmd_off = false</label>
			<nail x="10" y="50"/>
			<nail x="70" y="50"/>
		</transition>
	</template>
	<template>
		<name>FDI_Attacker</name>
		<location id="id25" x="40" y="80">
			<name x="30" y="50">Idle</name>
		</location>
		<location id="id26" x="190" y="80">
			<name x="180" y="50">Active</name>
		</location>
		<init ref="id25"/>
		<transition id="id27">
			<source ref="id25"/>
			<target ref="id26"/>
			<label kind="synchronisation" x="55" y="65">fdi_trigger!</label>
			<label kind="assignment" x="55" y="80">fdi_active = true</label>
		</transition>
	</template>
	<template>
		<name>Replay_Attacker</name>
		<location id="id28" x="40" y="80">
		</location>
		<init ref="id28"/>
		<transition id="id29">
			<source ref="id28"/>
			<target ref="id28"/>
			<label kind="synchronisation" x="-20" y="65">sensor_sample?</label>
			<label kind="assignment" x="-20" y="80">replay_buffer = sensor_level</label>
			<nail x="10" y="50"/>
			<nail x="70" y="50"/>
		</transition>
		<transition id="id30">
			<source ref="id28"/>
			<target ref="id28"/>
			<label kind="synchronisation" x="-20" y="65">replay_trigger!</label>
			<label kind="assignment" x="-20" y="80">replay_active = true</label>
			<nail x="10" y="50"/>
			<nail x="70" y="50"/>
		</transition>
	</template>
	<template>
		<name>DoS_Attacker</name>
		<location id="id31" x="40" y="80">
		</location>
		<init ref="id31"/>
		<transition id="id32">
			<source ref="id31"/>
			<target ref="id31"/>
			<label kind="synchronisation" x="-20" y="65">dos_block!</label>
			<label kind="assignment" x="-20" y="80">dos_active = true</label>
			<nail x="10" y="50"/>
			<nail x="70" y="50"/>
		</transition>
	</template>
	<system>
tank = Tank();
sensor = Sensor();
network = Network();
ids = IDS();
plc = PLC();
pump = Pump();

fdi = FDI_Attacker();
replay = Replay_Attacker();
dos = DoS_Attacker();

system tank, sensor, network, ids, plc, pump, fdi, replay, dos;
</system>
	<queries>
		<query>
			<formula>E&lt;&gt; tank.Overflow</formula>
			<comment>Overflow reachable under attack</comment>
			<result outcome="success" type="quality" timestamp="2026-03-31 23:55:46 +0530">
			</result>
		</query>
		<query>
			<formula>E&lt;&gt; intrusion_detected</formula>
			<comment>Attack detection reachable</comment>
			<result outcome="success" type="quality" timestamp="2026-03-31 23:55:52 +0530">
			</result>
		</query>
		<query>
			<formula>A[] !(pump_cmd_on &amp;&amp; pump_cmd_off)</formula>
			<comment>Control safety</comment>
			<result outcome="success" type="quality" timestamp="2026-03-31 23:55:57 +0530">
			</result>
		</query>
		<query>
			<formula>A[] not tank.Overflow</formula>
			<comment/>
			<result outcome="failure" type="quality" timestamp="2026-03-31 23:56:11 +0530">
			</result>
		</query>
		<query>
			<formula>A[] sensor_level == tank_level</formula>
			<comment/>
			<result outcome="failure" type="quality" timestamp="2026-03-31 23:56:20 +0530">
			</result>
		</query>
	</queries>
</nta>
